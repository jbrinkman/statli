---
interface Props {
	count: number;
}

const { count } = Astro.props;
---

<span
	class="review-badge"
	aria-label={`${count} review item${count !== 1 ? "s" : ""} need${count === 1 ? "s" : ""} attention`}
>
	{count}
</span>

<style>
	.review-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.25rem;
		height: 1.25rem;
		padding: 0 0.25rem;
		background: var(--color-needs-review);
		color: white;
		font-size: 0.7rem;
		font-weight: 700;
		border-radius: 999px;
	}
</style>
