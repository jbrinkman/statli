{
	"name": "statli",
	"version": "2.0.0",
	"description": "Project status tracking dashboard with AI-powered data ingestion",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"build:mcp": "tsc -p tsconfig.mcp.json",
		"preview": "astro preview",
		"start:mcp": "node dist/mcp-server/index.js",
		"seed": "tsx src/scripts/seed.ts",
		"validate:sources": "tsx src/scripts/validate.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e:install": "npx playwright install --with-deps chromium",
		"test:e2e": "playwright test"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"dependencies": {
		"@astrojs/node": "^11.1.1",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"astro": "^7.2.1",
		"better-auth": "^1.6.27",
		"better-sqlite3": "^13.0.3",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@playwright/test": "^1.62.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/uuid": "^10.0.0",
		"@vitest/coverage-v8": "^4.1.10",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
