# Server host (0.0.0.0 for container, localhost for local dev)
HOST=0.0.0.0

# Server port
PORT=4321

# SQLite database path
DATABASE_URL=./data/statli.db

# Better Auth secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32-minimum-32-chars

# API key for machine clients (MCP tool, cron jobs)
# Generate with: openssl rand -hex 32
STATLI_API_KEY=generate-with-openssl-rand-hex-32

# MCP server port (streamable HTTP transport)
MCP_PORT=4322

# Resend email service (required for password reset)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
