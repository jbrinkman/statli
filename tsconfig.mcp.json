{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist/mcp-server",
		"rootDir": "src/mcp-server",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": false,
		"declaration": true,
		"types": ["node"]
	},
	"include": ["src/mcp-server/**/*.ts"]
}
